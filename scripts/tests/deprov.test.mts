import { createServer } from "node:http";
import { usePeople } from "../../src/store/people";
import { useProvisioning } from "../../src/store/provisioning";
import { useOnboarding } from "../../src/store/onboarding";
import { SERVICES } from "../../src/lib/services";
import * as engine from "../../src/lib/provision";
import { isProvisioned, type TaskStatus } from "../../src/lib/provision";
import { execute } from "../../src/lib/serviceRuntime/runner";
import { REVOKE, UPDATE, appsOf } from "../../src/lib/serviceRuntime/reverse";
import { webhookVar } from "../../src/lib/serviceRuntime/types";
import { patched, provisioningImpact } from "../../src/lib/provisioning/impact";
import { reinstateOnboarding, runProvActions, terminateOnboarding, type Caller } from "../../src/lib/provisioning/orchestrate";

let pass = 0, fail = 0;
const ok = (n: string, c: boolean, x = "") => { if (c) pass++; else fail++; console.log(`  ${c ? "ok  " : "FAIL"} ${n}${c ? "" : "  " + x}`); };
const P = (name: string) => usePeople.getState().people.find((p) => p.name.startsWith(name))!;
const run = (id: string) => useProvisioning.getState().run.people.find((r) => r.personId === id)!;
const svc = (id: string, s: string) => run(id).tasks[SERVICES.findIndex((x) => x.id === s)];
/** The real server code, called directly instead of over HTTP. */
const direct: Caller = async (service, b) => execute(service, b.person as never, { attempt: b.attempt, retry: false, action: b.action as never, object: b.object });
const calls: string[] = [];
const spy: Caller = async (service, b) => { calls.push(`${service}:${b.action}:${b.object ?? ""}`); return direct(service, b); };

console.log("every service can be undone and updated");
const yash = P("Yash");
ok("each of the ten services has a reverse operation, and nine have an update (access changes per application instead)", SERVICES.every((s) => REVOKE[s.id]?.length >= 1) && SERVICES.filter((s) => (UPDATE[s.id]?.length ?? 0) >= 1).length === 9 && !UPDATE["access-svc"]);
const rev = await Promise.all(SERVICES.map((s) => execute(s.id, yash, { attempt: 1, retry: false, action: "deprovision" })));
ok("a deprovision succeeds in the sandbox and records every call, in order", rev.every((e, i) => e.ok && e.action === "deprovision" && e.phases.length === REVOKE[SERVICES[i].id].length && e.phases.every((p) => p.ok && p.request.length > 2)));
ok("…using revoking calls, not the original ones (suspend/cancel/release/void, never create)", rev.every((e) => e.phases.every((p) => /^(POST|PUT|DELETE)/.test(p.call) && /(suspend|void|withdraw|remove|unassign|cancel|deactivate|release|revoke|expire|lifecycle|sessions|DELETE|users\/\{id\})/i.test(`${p.label} ${p.call}`))));
const prov = await Promise.all(SERVICES.map((x) => execute(x.id, yash, { attempt: 1, retry: false })));
ok("a deprovision has its own trace id, separate from the provisioning run's", rev.every((e) => !prov.some((q) => q.traceId === e.traceId)) && new Set(rev.map((e) => e.traceId)).size === rev.length);
ok("a deprovision never produces an artifact or a pause", rev.every((e) => !e.artifact && !e.paused));
const upd = await Promise.all(SERVICES.map((s) => execute(s.id, yash, { attempt: 1, retry: false, action: "update" })));
ok("an update succeeds and reports what it moved", upd.filter((e) => e.service !== "access-svc").every((e) => e.ok && e.action === "update" && e.phases.length >= 1));
ok("…the offer is re-rendered and its old envelope replaced", upd[1].phases.map((p) => p.label).join().includes("Re-render") && upd[1].phases.map((p) => p.label).join().includes("Replace"));

console.log("\none application at a time");
const apps = appsOf(yash);
ok("a person's workflow grants a list of applications", apps.length >= 3, String(apps.length));
const slack = apps.find((a) => /slack/i.test(a)), github = apps.find((a) => /github/i.test(a)), other = apps.find((a) => !/slack|github/i.test(a))!;
const rs = slack ? await execute("access-svc", yash, { attempt: 1, retry: false, action: "deprovision", object: slack }) : null;
ok("revoking Slack alone makes one call to Slack", !slack || (rs!.ok && rs!.phases.length === 1 && /slack/i.test(rs!.phases[0].call) && rs!.object === slack));
const ro = await execute("access-svc", yash, { attempt: 1, retry: false, action: "deprovision", object: other });
ok("revoking any other app unassigns just that app", ro.ok && ro.phases.length === 1 && ro.phases[0].label === `Unassign ${other}` && ro.phases[0].request.includes(other));
const gr = await execute("access-svc", yash, { attempt: 1, retry: false, action: "provision", object: other });
ok("granting one app makes one assign call", gr.ok && gr.phases.length === 1 && gr.phases[0].label === `Assign ${other}`);
ok("an object on a service that isn't access is ignored (the whole service runs)", (await execute("identity-svc", yash, { attempt: 1, retry: false, action: "deprovision", object: "Slack" })).phases.length === REVOKE["identity-svc"].length);
ok("revoking the whole of access takes away every app in one run", (await execute("access-svc", yash, { attempt: 1, retry: false, action: "deprovision" })).phases.length === 3);

console.log("\na real system can refuse");
const seen: { action?: string; object?: string }[] = [];
const server = createServer((req, res) => { let b = ""; req.on("data", (c) => (b += c)); req.on("end", () => { const j = JSON.parse(b); seen.push({ action: j.action, object: j.object }); res.setHeader("content-type", "application/json"); if (req.url === "/refuse") { res.statusCode = 409; res.end(JSON.stringify({ ok: false, error: { code: "409", title: "Account has an open legal hold", cause: "Legal hold prevents deletion.", fix: "Ask Legal to lift the hold, then retry.", retryable: false } })); } else res.end(JSON.stringify({ ok: true, response: { done: true } })); }); });
await new Promise<void>((r) => server.listen(0, r));
const port = (server.address() as { port: number }).port;
process.env[webhookVar("identity-svc")] = `http://127.0.0.1:${port}/ok`;
const liveRev = await execute("identity-svc", yash, { attempt: 1, retry: false, action: "deprovision" });
ok("the live connector is told it is a deprovision", liveRev.ok && liveRev.mode === "live" && seen.length === REVOKE["identity-svc"].length && seen.every((s) => s.action === "deprovision"));
process.env[webhookVar("access-svc")] = `http://127.0.0.1:${port}/ok`;
seen.length = 0;
await execute("access-svc", yash, { attempt: 1, retry: false, action: "deprovision", object: other });
ok("…and which application", seen.length === 1 && seen[0].object === other);
process.env[webhookVar("identity-svc")] = `http://127.0.0.1:${port}/refuse`;
const refused = await execute("identity-svc", yash, { attempt: 1, retry: false, action: "deprovision" });
ok("a refusal comes back as a failure with cause and fix, and stops there", !refused.ok && refused.failure?.title === "Account has an open legal hold" && refused.phases.length === 1);
delete process.env[webhookVar("identity-svc")]; delete process.env[webhookVar("access-svc")];
server.close();

console.log("\nwhat a change means for provisioning");
const base = P("Riya");
const done = (s: string) => (s === "reminder-svc" || s === "identity-svc" || s === "access-svc" || s === "letter-svc" || s === "payroll-svc" || s === "idcard-svc" || s === "facility-svc" || s === "agenda-svc" || s === "bgv-svc" || s === "collect-svc" ? ("done" as const) : undefined);
const imp = (patch: Parameters<typeof patched>[1], st: (s: string) => TaskStatus | undefined = done) => provisioningImpact(base, patched(base, patch), st);
const by = (a: ReturnType<typeof imp>, kind: string) => a.filter((x) => x.kind === kind);
ok("no change, no work", imp({}).length === 0 && imp({ role: base.role }).length === 0);
const dateOnly = imp({ startDate: "2026-12-01" });
ok("a new joining date moves the calendar, pass, payroll, offer and nudges, and revokes nothing", ["agenda-svc", "facility-svc", "payroll-svc", "letter-svc", "reminder-svc", "bgv-svc"].every((s) => dateOnly.some((a) => a.service === s && a.kind === "update")) && by(dateOnly, "deprovision").length === 0);
ok("…but doesn't touch the directory entry or the app access (nothing there depends on the date)", !dateOnly.some((a) => a.service === "identity-svc" || a.service === "access-svc"));
const lvl = imp({ level: "Leader", grade: "L8" });
const lostGained = lvl.filter((a) => a.service === "access-svc");
ok("a different level changes the applications: some revoked, some granted, each named with the reason", lostGained.length > 0 && lostGained.every((a) => a.object && a.reason.includes("workflow")), JSON.stringify(lostGained.map((a) => `${a.kind}:${a.object}`)));
ok("…and reissues the offer and payroll", lvl.some((a) => a.service === "letter-svc") && lvl.some((a) => a.service === "payroll-svc"));
const dep = imp({ department: "Finance" });
ok("moving to Finance revokes engineering-only apps and grants finance ones", by(dep, "deprovision").some((a) => a.object) && by(dep, "provision").some((a) => a.object), JSON.stringify(dep.filter((a) => a.object).map((a) => `${a.kind}:${a.object}`)));
ok("…and updates the directory entry, payroll and day-1 plan", ["identity-svc", "payroll-svc", "agenda-svc"].every((s) => dep.some((a) => a.service === s)));
const move = imp({ location: "Austin" });
ok("moving city moves the desk, pass and card, and refreshes documents for the new country", ["facility-svc", "idcard-svc", "collect-svc", "payroll-svc"].every((s) => move.some((a) => a.service === s && a.kind === "update")) && move.find((a) => a.service === "collect-svc")!.reason.includes("country"));
ok("a new manager updates the directory and day-1 events only (plus nudges)", imp({ manager: "Dev Patel" }).map((a) => a.service).sort().join() === ["agenda-svc", "identity-svc", "reminder-svc"].sort().join());
ok("revokes come first so nothing is moved before access is taken away", lvl.findIndex((a) => a.kind === "deprovision") <= lvl.findIndex((a) => a.kind === "update") || !lvl.some((a) => a.kind === "deprovision"));
const early = imp({ startDate: "2026-12-01" }, (s) => (s === "reminder-svc" ? "done" : s === "agenda-svc" ? "queued" : undefined));
ok("services that haven't run yet are left alone (they will use the new details)", early.length === 1 && early[0].service === "reminder-svc");
ok("a service that was revoked is not updated", !imp({ startDate: "2026-12-01" }, (s) => (s === "agenda-svc" ? "revoked" : "done")).some((a) => a.service === "agenda-svc"));

console.log("\ntake one service, or one app, away from a person");
const tid = P("Aarav").id;
const st = (s: string) => svc(tid, s).status;
ok("the seeded person has services provisioned", SERVICES.filter((s) => isProvisioned(svc(tid, s.id))).length >= 6);
const before = useProvisioning.getState().run.events.length;
const r1 = await runProvActions([{ service: "payroll-svc", kind: "deprovision", reason: "payroll is being handled elsewhere" }], tid, "Priya Nair", spy);
ok("revoking a service marks it revoked, with who and why", r1.ok === 1 && st("payroll-svc") === "revoked" && svc(tid, "payroll-svc").revocation?.by === "Priya Nair" && !!svc(tid, "payroll-svc").revocation?.reason.includes("elsewhere"));
ok("…keeps what the server did (every call, its trace)", svc(tid, "payroll-svc").revocation!.execution.phases.length === 3 && !!svc(tid, "payroll-svc").revocation!.execution.traceId);
const ev = useProvisioning.getState().run.events.slice(before);
ok("…and writes it all to the agent log: the request, each call, the result", ev.some((e) => /revoke requested by Priya Nair/.test(e.text)) && ev.filter((e) => e.call && e.service === "payroll-svc").length === 3 && ev.some((e) => /revoked ·/.test(e.text) && e.kind === "ok"));
const app = appsOf(P("Aarav")).find((a) => !/slack|github/i.test(a))!;
await runProvActions([{ service: "access-svc", kind: "deprovision", object: app, reason: `${app} is not needed` }], tid, "Priya Nair", spy);
ok("revoking one app marks only that app, the rest of access stays", st("access-svc") === "done" && Object.keys(svc(tid, "access-svc").revokedObjects ?? {}).join() === app);
await runProvActions([{ service: "access-svc", kind: "provision", object: app, reason: "needed again" }], tid, "Priya Nair", spy);
ok("granting it back clears the mark", Object.keys(svc(tid, "access-svc").revokedObjects ?? {}).length === 0);
await runProvActions([{ service: "facility-svc", kind: "update", reason: "joining date moved" }], tid, "Priya Nair", spy);
ok("an update is recorded without changing the service's status", st("facility-svc") !== "revoked" && svc(tid, "facility-svc").lastUpdate?.reason === "joining date moved");
const bad: Caller = async () => null;
const fb = await runProvActions([{ service: "idcard-svc", kind: "deprovision", reason: "x" }], tid, "Priya Nair", bad);
ok("when the service can't be reached nothing is marked revoked, and the failure is shown with a retry", fb.failed === 1 && st("idcard-svc") !== "revoked" && svc(tid, "idcard-svc").revokeFailure?.retryable === true);
await runProvActions([{ service: "idcard-svc", kind: "deprovision", reason: "x" }], tid, "Priya Nair", direct);
ok("…and the retry works and clears it", st("idcard-svc") === "revoked" && !svc(tid, "idcard-svc").revokeFailure);
useProvisioning.getState().reprovision(tid, "payroll-svc", "Priya Nair");
ok("provisioning a revoked service again puts it back in the queue, clean", st("payroll-svc") === "queued" && !svc(tid, "payroll-svc").revocation && run(tid).state === "running");
ok("a service that depends on a revoked one is skipped (and says it was revoked), not run", (() => {
  const { initRun, stepRun } = engine;
  let r = initRun([P("Meera")]);
  r = { ...r, people: r.people.map((pr) => ({ ...pr, tasks: pr.tasks.map((t, i) => (SERVICES[i].id === "identity-svc" ? { ...t, status: "revoked" as const } : t)) })) };
  for (let i = 0; i < 400 && r.people[0].state !== "finished"; i++) r = stepRun(r, [P("Meera")]);
  const ag = r.people[0].tasks[SERVICES.findIndex((x) => x.id === "agenda-svc")], ac = r.people[0].tasks[SERVICES.findIndex((x) => x.id === "access-svc")];
  return ag.status === "skipped" && ac.status === "skipped" && ag.detail.includes("was revoked") && !ag.detail.includes("failed");
})());

console.log("\nterminating a person's whole onboarding");
const kid = P("Kabir").id;
const k0 = SERVICES.filter((s) => isProvisioned(svc(kid, s.id))).length;
calls.length = 0;
const t = await terminateOnboarding(kid, "Priya Nair", "Candidate withdrew", spy);
ok("every service that had created something is deprovisioned", t.revoked === k0 && t.failed === 0 && calls.length === k0, `${t.revoked}/${k0}`);
ok("…each task is revoked or cancelled, none left running", run(kid).tasks.every((x) => x.status === "revoked" || x.status === "skipped") && run(kid).state === "finished");
ok("the account is removed last, after the apps and records that depend on it", (() => { const order = calls.map((c) => c.split(":")[0]); const i = order.indexOf("identity-svc"); return i === -1 || ["access-svc", "agenda-svc"].every((s) => order.indexOf(s) === -1 || order.indexOf(s) < i); })(), calls.join(" "));
ok("things that hadn't started are cancelled with a reason", run(kid).tasks.filter((x) => x.status === "skipped").every((x) => x.detail.includes("cancel")));
ok("the person is marked terminated with who, when and why", !!P("Kabir").terminated && P("Kabir").terminated!.reason === "Candidate withdrew" && P("Kabir").terminated!.by === "Priya Nair");
ok("it is in the audit trail and the agent log", useOnboarding.getState().audit.some((a) => a.personId === kid && a.action === "Onboarding terminated") && useProvisioning.getState().run.events.some((e) => e.personId === kid && /onboarding terminated by Priya Nair/.test(e.text)));
ok("terminating twice does nothing more", (await terminateOnboarding(kid, "Priya Nair", "again", spy)).revoked === 0);
ok("nobody else was touched", SERVICES.every((s) => svc(P("Meera").id, s.id).status !== "revoked"));
const n = reinstateOnboarding(kid, "Priya Nair");
ok("reinstating makes them active and runs every revoked or cancelled service again", n > 0 && !P("Kabir").terminated && run(kid).tasks.every((x) => x.status === "queued") && run(kid).state === "running", `${n} ${run(kid).tasks.map((x) => x.status).join()}`);
ok("…and says so in the audit trail", useOnboarding.getState().audit.some((a) => a.personId === kid && a.action === "Onboarding reinstated"));

console.log("\nafter a reload");
const tid2 = P("Tanvi").id;
await terminateOnboarding(tid2, "Priya Nair", "Offer rescinded", direct);
await runProvActions([{ service: "access-svc", kind: "deprovision", object: app, reason: "no longer needed" }], P("Meera").id, "Priya Nair", direct);
await runProvActions([{ service: "payroll-svc", kind: "deprovision", reason: "handled elsewhere" }], P("Meera").id, "Priya Nair", direct);
const saved = JSON.parse(JSON.stringify(useProvisioning.getState().ledger));
const rebuilt = engine.fastForward(engine.initRun(usePeople.getState().people), usePeople.getState().people);
useProvisioning.setState({ run: rebuilt, ledger: saved });
useProvisioning.getState().restoreLedger();
const tan = run(tid2);
ok("a terminated person comes back terminated: every service revoked or cancelled, nothing running or failed, record closed", tan.state === "finished" && tan.tasks.every((x) => x.status === "revoked" || x.status === "skipped"), tan.tasks.map((x) => x.status).join());
ok("…with what was revoked kept (who, why, and what the server did)", tan.tasks.filter((x) => x.status === "revoked").every((x) => x.revocation?.by === "Priya Nair" && x.revocation.execution.phases.length >= 1 && x.revocation.reason.includes("Offer rescinded")));
ok("a single revoked service comes back revoked", svc(P("Meera").id, "payroll-svc").status === "revoked");
ok("a single revoked application comes back revoked, the service still live", Object.keys(svc(P("Meera").id, "access-svc").revokedObjects ?? {}).join() === app && svc(P("Meera").id, "access-svc").status !== "revoked");
ok("someone who was reinstated is not terminated again by a reload", !P("Kabir").terminated && run(P("Kabir").id).tasks.every((x) => x.status !== "revoked"));
ok("people nobody touched are unchanged", SERVICES.every((x) => svc(P("Emily").id, x.id).status === rebuilt.people.find((r) => r.personId === P("Emily").id)!.tasks[SERVICES.indexOf(x)].status));
useProvisioning.getState().reprovision(P("Meera").id, "payroll-svc", "Priya Nair");
ok("provisioning a service again removes it from the saved ledger", !useProvisioning.getState().ledger[P("Meera").id]?.services["payroll-svc"]);

console.log(`\npassed ${pass}, failed ${fail}`);
process.exit(fail ? 1 : 0);
