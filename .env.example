# Session signing (required in production)
SESSION_SECRET=replace-with-a-long-random-string

# Supabase (agent logs). URL + publishable key come from Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only gate: generate with `openssl rand -hex 24`. The database rejects any request without it
# in the x-superjoin-key header, so the public key alone cannot read or write logs.
SUPABASE_APP_KEY=

# Assistant answers + reading PDFs/images (optional; without it answers are quoted from policy and PDFs go to a reviewer).
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5-5

# Provisioning services run on a built-in sandbox connector. Point one at a real system with a webhook
# (see README → Provisioning services). Requests are signed with SERVICE_WEBHOOK_SECRET.
# SERVICE_WEBHOOK_SECRET=
# SERVICE_WEBHOOK_IDENTITY_SVC=https://hooks.example.com/identity
# SERVICE_WEBHOOK_ACCESS_SVC=https://hooks.example.com/access

# Sync new joiners from a live ATS tenant (otherwise Ingest → Sync from ATS talks to a built-in demo tenant).
# ATS_GREENHOUSE_URL=https://harvest.greenhouse.io/v1/applications?status=hired
# ATS_GREENHOUSE_TOKEN=
# ATS_LEVER_URL=https://api.lever.co/v1/opportunities?stage=hired
# ATS_LEVER_TOKEN=
# ATS_WORKDAY_URL=https://services1.wd3.myworkday.com/ccx/service/customreport2/TENANT/ISU/New_Hires?format=json
# ATS_WORKDAY_TOKEN=

# WhatsApp (optional): reminders, approvals and question answering on WhatsApp. See README → WhatsApp.
# Without WHATSAPP_TOKEN + WHATSAPP_PHONE_NUMBER_ID everything runs in a sandbox and nothing is sent.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# Required for the webhook to accept anything: the Meta app's secret, used to verify every call is from Meta.
# WHATSAPP_APP_SECRET=
# The word you give Meta when subscribing the webhook.
# WHATSAPP_VERIFY_TOKEN=
# The number people message, digits only (country code first): used for the QR code and join links.
# WHATSAPP_DISPLAY_NUMBER=
# Approved message templates, for messages sent more than 24 hours after the person last wrote (WhatsApp's rule).
# WHATSAPP_TEMPLATE_NOTIFY=
# WHATSAPP_TEMPLATE_APPROVAL=
# WHATSAPP_TEMPLATE_LANG=en
# An extra word that means "leave", like chatflow's sandbox exit code (EXIT and LEAVE always work).
# WHATSAPP_EXIT_CODE=
# Only if the number is shared with another app that forwards messages here (README → Sharing a number).
# WHATSAPP_ROUTER_KEY=
# Local development before the SQL has been run: keep WhatsApp state in memory instead of Supabase.
# WHATSAPP_STORE=memory

# Email reminders. Without these the Reminders page runs in preview mode (renders, logs, never delivers).
# RESEND_API_KEY=
# EMAIL_FROM="superjoin <reminders@your-domain.com>"
# While testing, funnel every email to one inbox:
# EMAIL_TEST_RECIPIENT=you@example.com
